      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// ===== Сетка усреднения (LONG), MEXC. Перенос grid.py + mexc.py + app.calculate =====\nconst COEF = 0.80;            // вход, когда сгорело 80% маржи, которую можно потерять до ликвидации\nconst MARGINS = [1, 2, 3, 4];\nconst LEV_MIN = 1.5, LEV_MAX = 500;\n\nclass GridError extends Error {}\n\nconst num = (v, d = null) => {\n  if (v === null || v === undefined || v === '') return d;\n  const x = Number(v);\n  return Number.isFinite(x) ? x : d;\n};\nconst pick = (o, ...names) => {\n  for (const n of names) if (o && o[n] !== undefined && o[n] !== null) return o[n];\n  return null;\n};\nconst rnd = (x, p) => { const m = Math.pow(10, p); return Math.round(x * m) / m; };\nconst decimalsOf = (text) => {\n  const s = String(text).trim();\n  if (/e/i.test(s)) return 8;\n  const i = s.indexOf('.');\n  return i < 0 ? 0 : s.length - i - 1;\n};\n\nfunction normalizeContract(raw) {\n  const symbol = pick(raw, 'symbol') || '';\n  return {\n    symbol,\n    base: pick(raw, 'baseCoin', 'baseCoinName') || symbol.split('_')[0],\n    quote: pick(raw, 'quoteCoin', 'quoteCoinName') || (symbol.split('_')[1] || ''),\n    max_leverage: num(pick(raw, 'maxLeverage')),\n    min_vol: num(pick(raw, 'minVol'), 0),\n    contract_size: num(pick(raw, 'contractSize', 'faceValue'), 1) || 1,\n    price_unit: num(pick(raw, 'priceUnit', 'tickSize', 'priceTick')),\n    price_scale: Math.trunc(num(pick(raw, 'priceScale', 'pricePrecision'), 4)),\n    taker_fee: num(pick(raw, 'takerFeeRate')),\n    mmr_base: num(pick(raw, 'maintenanceMarginRate')),     // null = биржа не дала\n    risk_base_vol: num(pick(raw, 'riskBaseVol'), 0),\n    risk_incr_vol: num(pick(raw, 'riskIncrVol'), 0),\n    risk_incr_mmr: num(pick(raw, 'riskIncrMmr'), 0),\n    risk_level_limit: Math.trunc(num(pick(raw, 'riskLevelLimit'), 1)),\n  };\n}\n\nfunction tierFor(c, coins) {\n  const incr = c.risk_incr_vol || 0, base = c.risk_base_vol || 0;\n  const maxLevel = Math.max(1, c.risk_level_limit || 1);\n  if (incr <= 0) return 1;\n  const vol = coins / (c.contract_size || 1);\n  if (vol <= base) return 1;\n  return Math.min(1 + Math.ceil((vol - base) / incr), maxLevel);\n}\nfunction mmrFor(c, coins) {\n  if (c.mmr_base === null) return null;\n  const incr = c.risk_incr_mmr || 0;\n  return c.mmr_base + incr * (tierFor(c, coins) - 1);\n}\nconst roundToTick = (price, c) => {\n  if (!c || !c.price_unit || c.price_unit <= 0) return price;\n  return rnd(Math.round(price / c.price_unit) * c.price_unit, c.price_scale || 8);\n};\n\nfunction buildGrid(p1, L, mmrFn, lot, fee, coef = COEF) {\n  if (!(p1 > 0)) throw new GridError('Цена входа должна быть больше нуля.');\n  if (!(L > 1)) throw new GridError('Плечо должно быть больше 1.');\n  const rows = [];\n  let cumMargin = 0, cumCoins = 0, price = p1;\n  MARGINS.forEach((margin, i) => {\n    if (i > 0) {\n      const prev = rows[rows.length - 1];\n      price = prev.avg - coef * (prev.avg - prev.liq);\n      if (price <= 0) throw new GridError('Цепочка ушла в отрицательные цены — плечо слишком велико.');\n    }\n    let coins, marginUsed, count = null;\n    if (lot) {\n      const perContract = price * lot * (1 / L + fee);\n      count = perContract > 0 ? Math.floor(margin / perContract) : 0;\n      if (count < 1) throw new GridError(`Шаг ${i + 1}: на ${margin} USDT при плече ${L}x не набирается даже один контракт.`);\n      coins = count * lot;\n      marginUsed = coins * price / L;\n    } else {\n      coins = margin * L / price;\n      marginUsed = margin;\n    }\n    cumMargin += marginUsed;\n    cumCoins += coins;\n    const avg = L * cumMargin / cumCoins;\n    let k = 1;\n    if (mmrFn) {\n      const mmr = mmrFn(cumCoins);\n      if (mmr === null) throw new GridError('Нет ставки поддерживающей маржи — расчёт невозможен.');\n      k = 1 - mmr * L;\n      if (k <= 0) throw new GridError(`Плечо ${L}x невозможно при MMR ${(mmr * 100).toFixed(3)}%: предел для этой монеты — ${Math.round(1 / mmr)}x.`);\n      k = Math.min(1, k);\n    }\n    const liq = avg * (1 - k / L);\n    rows.push({ step: i + 1, price, margin, margin_used: marginUsed, fee: coins * price * fee,\n                contracts: count, coins, cum_coins: cumCoins, cum_margin: cumMargin, avg, liq, k });\n  });\n  const span = rows[0].price - rows[3].price;\n  rows.forEach(r => { r.pct = span ? (rows[0].price - r.price) / span * 100 : 0; });\n  return rows;\n}\n\n// Целые контракты делают ликвидацию ступенчатой по плечу: перебираем целые плечи.\nfunction solveExchange(p1, target, mmrFn, maxLev, lot, fee) {\n  const hi = Math.trunc(Math.min(maxLev || LEV_MAX, LEV_MAX));\n  let best = null, gap = null;\n  for (let L = 2; L <= hi; L++) {\n    let liq;\n    try { liq = buildGrid(p1, L, mmrFn, lot, fee)[3].liq; } catch (e) { if (e instanceof GridError) continue; throw e; }\n    const g = Math.abs(liq - target);\n    if (gap === null || g < gap - 1e-12) { best = L; gap = g; }\n  }\n  if (best === null) throw new GridError('Сетку не построить ни на одном плече: суммы шагов слишком малы для минимального контракта этой пары.');\n  return best;\n}\n\n// Без данных о контракте: гладкая функция, бисекция и обычное округление.\nfunction solveSmooth(p1, target, mmrFn, maxLev) {\n  if (!(target > 0)) throw new GridError('Целевая ликвидация должна быть больше нуля.');\n  if (target >= p1) throw new GridError('Целевая ликвидация должна быть ниже цены входа (LONG).');\n  let hi = Math.min(maxLev || LEV_MAX, LEV_MAX);\n  const f = L => buildGrid(p1, L, mmrFn, null, 0)[3].liq - target;\n  const ok = L => { try { f(L); return true; } catch (e) { if (e instanceof GridError) return false; throw e; } };\n  if (!ok(hi)) {\n    if (!ok(LEV_MIN)) throw new GridError(`Сетку не построить даже при плече ${LEV_MIN}x.`);\n    let good = LEV_MIN, bad = hi;\n    for (let i = 0; i < 60; i++) { const m = (good + bad) / 2; if (ok(m)) good = m; else bad = m; }\n    hi = good;\n  }\n  const fLo = f(LEV_MIN), fHi = f(hi);\n  if (fLo * fHi > 0) {\n    if (fHi < 0) throw new GridError(`Цель недостижима: при максимальном плече ${Math.round(hi)}x ликвидация шага 4 равна ${(fHi + target).toPrecision(6)}, это ниже цели ${target}.`);\n    throw new GridError(`Цель недостижима: даже при плече ${LEV_MIN}x ликвидация шага 4 равна ${(fLo + target).toPrecision(6)}, это выше цели ${target}.`);\n  }\n  let lo = LEV_MIN, h = hi, flo = fLo;\n  for (let i = 0; i < 200 && (h - lo) / 2 > 1e-10; i++) {\n    const m = (lo + h) / 2, fm = f(m);\n    if (fm === 0) { lo = h = m; break; }\n    if (flo * fm < 0) h = m; else { lo = m; flo = fm; }\n  }\n  const exact = (lo + h) / 2;\n  return Math.max(2, Math.min(Math.floor(exact + 0.5), Math.trunc(hi)));\n}\n\n// body — запрос страницы; detail — ответ MEXC по контракту (или null, если биржа не ответила)\nfunction calculate(body, detail, detailFailed) {\n  const p1Raw = String(body.p1 || '').trim().replace(',', '.');\n  if (!p1Raw) throw new GridError('Нужна цена входа.');\n  const p1 = Number(p1Raw);\n  if (!Number.isFinite(p1)) throw new GridError('Проверьте числа — что-то введено не так.');\n\n  const notes = [];\n  const symbol = String(body.symbol || '').trim().toUpperCase();\n  let contract = null;\n  if (symbol) {\n    if (detailFailed) {\n      notes.push('Биржа не ответила — ликвидация без её резерва.');\n    } else {\n      let data = detail && detail.data;\n      if (Array.isArray(data)) data = data.find(d => d && d.symbol === symbol) || null;\n      if (!data || !data.symbol) throw new GridError(`Пары ${symbol} нет на фьючерсах MEXC.`);\n      contract = normalizeContract(data);\n    }\n  }\n\n  const hasMmr = !!contract && contract.mmr_base !== null;\n  const mmrFn = hasMmr ? (coins => mmrFor(contract, coins)) : null;\n  if (contract && !hasMmr) notes.push('MEXC не дала ставку поддерживающей маржи для этой пары.');\n\n  const lot = contract ? contract.contract_size : null;\n  const fee = contract ? (contract.taker_fee || 0) : 0;\n  const maxLev = contract ? contract.max_leverage : null;\n\n  let L;\n  if (body.mode === 'leverage') {\n    const raw = Number(String(body.leverage || '').replace(',', '.'));\n    if (!Number.isFinite(raw) || String(body.leverage || '').trim() === '') throw new GridError('Укажите плечо.');\n    L = Math.round(raw);\n    if (L < 2) throw new GridError('Плечо должно быть от 2x.');\n    if (maxLev && L > maxLev) throw new GridError(`На этой паре плечо максимум ${maxLev}x.`);\n  } else {\n    const t = Number(String(body.target_liq || '').replace(',', '.'));\n    if (!Number.isFinite(t) || String(body.target_liq || '').trim() === '') throw new GridError('Укажите цель по ликвидации.');\n    if (t <= 0) throw new GridError('Целевая ликвидация должна быть больше нуля.');\n    if (t >= p1) throw new GridError('Целевая ликвидация должна быть ниже цены входа (LONG).');\n    L = lot ? solveExchange(p1, t, mmrFn, maxLev, lot, fee) : solveSmooth(p1, t, mmrFn, maxLev);\n  }\n\n  const rows = buildGrid(p1, L, mmrFn, lot, fee);\n  const places = contract ? contract.price_scale : Math.max(decimalsOf(p1Raw), 4);\n\n  if (!hasMmr) notes.push(`Расчёт без резерва биржи. Он верен, только если MMR монеты меньше ${(15 / L).toFixed(3)}%. Выше — добор встанет ниже ликвидации.`);\n  if (contract && contract.min_vol) {\n    const small = rows.filter(r => r.contracts !== null && r.contracts < contract.min_vol).map(r => r.step);\n    if (small.length) notes.push(`Шаг ${small.join(', ')}: количество меньше минимального ордера биржи (${contract.min_vol} контр.) — такой ордер не пройдёт.`);\n  }\n  const spent = rows.reduce((s, r) => s + r.margin_used + r.fee, 0);\n  if (lot && spent < 9.9) notes.push(`Из 10 USDT биржа задействует ${spent.toFixed(2)} — остальное не влезает в целое число контрактов. Точки входа посчитаны по фактическим суммам.`);\n\n  return {\n    leverage: L,\n    places,\n    mmr: { known: hasMmr, value: hasMmr ? (1 - rows[0].k) / L : null,\n           tier: hasMmr ? tierFor(contract, rows[0].cum_coins) : null, source: hasMmr ? 'MEXC' : 'нет данных' },\n    exchange_lots: !!lot,\n    qty_places: lot ? decimalsOf(String(lot)) : 4,\n    notes,\n    rows: rows.map(r => ({\n      step: r.step,\n      price: rnd(roundToTick(r.price, contract), places),\n      margin: r.margin,\n      margin_used: rnd(r.margin_used, 4),\n      coins: r.coins,\n      contracts: r.contracts,\n      liq: rnd(roundToTick(r.liq, contract), places),\n      pct: rnd(r.pct, 2),\n    })),\n  };\n}\n\n\n// ===== Точка входа узла =====\nconst body = $('Вебхук: расчёт').first().json.body || {};\nconst d = $input.first().json;\nconst failed = !!d.error;            // HTTP-ошибка: биржа не ответила\ntry {\n  return [{ json: calculate(body, failed ? null : d, failed) }];\n} catch (e) {\n  if (e instanceof GridError) return [{ json: { error: e.message } }];\n  return [{ json: { error: 'Ошибка расчёта: ' + e.message } }];\n}\n"
      },
