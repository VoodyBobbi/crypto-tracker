    {
      "parameters": {
        "jsCode": "// Живые цены только для пар, видимых на странице\nconst q = String(($('Вебхук: цены').first().json.query || {}).symbols || '');\nconst wanted = new Set(q.split(',').map(s => s.trim().toUpperCase()).filter(Boolean).slice(0, 300));\nconst tick = $input.first().json;\nif (tick.error || tick.success === false || !Array.isArray(tick.data)) {\n  return [{ json: { error: 'MEXC не отвечает' } }];\n}\nconst prices = {};\nfor (const x of tick.data) {\n  if (wanted.has(x.symbol)) {\n    prices[x.symbol] = { price: Number(x.lastPrice), change: Number(x.riseFallRate) * 100,\n                         volume: Number(x.amount24) || 0 };\n  }\n}\nreturn [{ json: { ts: Date.now() / 1000, fresh: true, prices } }];\n"
      },
