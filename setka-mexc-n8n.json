    {
      "parameters": {
        "jsCode": "// Список USDT-фьючерсов MEXC с ценой и объёмом, по убыванию оборота\nconst det = $('MEXC: все контракты').first().json;\nconst tick = $('MEXC: цены для списка').first().json;\nif (det.error || det.success === false || !Array.isArray(det.data)) {\n  return [{ json: { error: 'MEXC не отвечает. Проверьте, что у сервера n8n есть доступ к contract.mexc.com' } }];\n}\nconst t = {};\nif (!tick.error && Array.isArray(tick.data)) for (const x of tick.data) t[x.symbol] = x;\nconst pairs = det.data\n  .filter(c => c && c.quoteCoin === 'USDT' && String(c.symbol || '').endsWith('_USDT') && !c.isHidden)\n  .map(c => {\n    const x = t[c.symbol] || {};\n    const scale = Number(c.priceScale);\n    return {\n      symbol: c.symbol,\n      base: c.baseCoin || c.symbol.split('_')[0],\n      leverage: Number(c.maxLeverage) || null,\n      price: x.lastPrice != null ? Number(x.lastPrice) : null,\n      change: x.riseFallRate != null ? Number(x.riseFallRate) * 100 : null,\n      volume: Number(x.amount24) || 0,\n      places: Number.isFinite(scale) ? scale : 4,\n    };\n  })\n  .sort((a, b) => b.volume - a.volume);\nreturn [{ json: { ts: Date.now() / 1000, pairs } }];\n"
      },
